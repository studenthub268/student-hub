# Student Hub - Environment Variables
# Copy this file to `.env.local` and fill in your values.

# ── App ─────────────────────────────────────────────────────────────
# Public URL of your deployment (no trailing slash). Used for email links
# and metadata. Falls back to http://localhost:3000 in development.
APP_URL=https://your-app.vercel.app

# ── Database (Neon) ─────────────────────────────────────────────────
# Get this from Neon Console → Project → Connection Details → Pooled connection
DATABASE_URL=postgresql://username:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require

# ── Auth ────────────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=your-secret-here
# Set to your deployed URL (no trailing slash)
AUTH_URL=https://your-app.vercel.app

# OAuth providers (optional; remove the provider if you don't use it)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── File Storage (Cloudflare R2) ────────────────────────────────────
# Get from Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.account.r2.dev

# ── Email (Resend) ──────────────────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
# Webhook secret for the /api/webhooks/resend endpoint (Resend dashboard → Webhooks)
RESEND_WEBHOOK_SECRET=your-webhook-secret

# Optional email tuning
# EMAIL_DAILY_LIMIT=10

# ── Alerts (Slack) ──────────────────────────────────────────────────
# Optional. When set, bounce/complaint alerts are posted to this webhook.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# BOUNCE_RATE_THRESHOLD=10
# BOUNCE_RATE_WINDOW_HOURS=24
# BOUNCE_RATE_MIN_EVENTS=20
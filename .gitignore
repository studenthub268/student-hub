# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local run logs (npm run dev/start output redirect)
dev-server.log
dev-server.err.log
serve.log
build.log

# Lighthouse reports written by verification passes
lh-*.json

# env files (never commit real secrets; keep the example template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Freebuff / Claude
cursor*
.freebuff*
.claude*

# screenshot artifacts from verification scripts
scripts/*.png

# local-only DB row backup produced by the clerk_id drop (migration 0006)
.clerk-id-backup.local.json
